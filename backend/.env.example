# MediVaani settings. Copy this file to a new file named ".env" (same folder) and fill in your values.
# Never share .env or commit it to Git (it is already in .gitignore).

PORT=3000

# ---- Speech to text: AI4Bharat IndicConformer (runs from backend/asr) ----
# 1) Make a free account at huggingface.co, open
#    https://huggingface.co/ai4bharat/indic-conformer-600m-multilingual and accept the conditions.
# 2) Create a "read" access token in your Hugging Face settings and paste it here:
HF_TOKEN=
# Address of the speech service (leave as is if you run it on this computer):
ASR_SERVICE_URL=http://localhost:8001
# "ctc" is faster, "rnnt" is sometimes more accurate:
ASR_DECODING=ctc

# ---- Translation: Ollama (local AI, no key needed) ----
# Use "mymemory" instead if you have not installed Ollama yet.
TRANSLATION_PROVIDER=mymemory
OLLAMA_URL=http://localhost:11434
# Any model you have pulled. Bigger models translate better but need more memory.
OLLAMA_MODEL=gemma3:4b

# Optional: a real email raises the free daily limit of the "mymemory" option
MYMEMORY_EMAIL=